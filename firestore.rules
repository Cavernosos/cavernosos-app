rules_version = '2';

// Regras do Firestore do site Cavernosos.
// Para aplicar: Firebase Console → Firestore Database → Regras → colar este arquivo → Publicar.
// O site é fechado: sem login, nada pode ser lido nem gravado (exceto o necessário para entrar).
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isUser() {
      return request.auth != null && exists(userDoc()) && get(userDoc()).data.active == true;
    }
    function isAdmin() { return isUser() && get(userDoc()).data.role == 'admin'; }
    // Mesma lógica do site: admin pode tudo, usuário segue as próprias permissões.
    function can(p) { return isAdmin() || (isUser() && p in get(userDoc()).data.perms); }
    function appInitialized() { return exists(/databases/$(database)/documents/settings/app); }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /players/{id} {
      allow read: if isUser();
      allow create: if can('players.create');
      allow update: if can('players.edit');
      allow delete: if can('players.delete');
    }

    match /matches/{id} {
      allow read: if isUser();
      allow create: if can('matches.create');
      allow update: if (can('matches.score') && onlyChanged(['presence', 'goals', '_order']))
                    || (can('matches.finalize') && onlyChanged(['finalized', '_order']))
                    || isAdmin();
      allow delete: if can('matches.delete');
    }

    match /videos/{id} {
      allow read: if isUser();
      allow create: if can('videos.create');
      allow update, delete: if can('videos.delete');
    }

    match /games_videos/{id} {
      allow read: if isUser();
      allow create: if can('games.videos.create');
      allow update, delete: if can('games.videos.delete');
    }

    match /outros_videos/{id} {
      allow read: if isUser();
      allow create: if can('outros.videos.create');
      allow update, delete: if can('outros.videos.delete');
    }

    // ---------- BoardGame ----------
    match /bg_games/{id} {          // biblioteca de jogos (as partidas apontam para cá)
      allow read: if isUser();
      allow create: if can('bg.games.create');
      allow update: if can('bg.games.edit');
      allow delete: if can('bg.games.delete');
    }
    match /bg_matches/{id} {
      allow read: if isUser();
      allow create: if can('bg.matches.create');
      allow update: if can('bg.matches.edit');
      allow delete: if can('bg.matches.delete');
    }
    match /bg_videos/{id} {
      allow read: if isUser();
      allow create: if can('bg.videos.create');
      allow update, delete: if can('bg.videos.delete');
    }
    match /bg_photos/{id} {
      allow read: if isUser();
      allow create: if can('bg.photos.create');
      allow update, delete: if can('bg.photos.delete');
    }

    // Diretório: nome e ambientes de cada usuário (sem e-mail nem permissões),
    // para quem está logado escolher jogadores. Só o Admin mantém.
    match /directory/{uid} {
      allow read: if isUser();
      allow write: if isAdmin();
    }

    match /mural/{id} {
      allow read: if isUser();
      allow create: if can('photos.create');
      allow update, delete: if can('photos.delete');
    }

    // Cadastro dos usuários: só Admin altera.
    // - O primeiro Admin pode se criar enquanto o site ainda não foi configurado.
    // - Qualquer pessoa pode se cadastrar pelo site, mas só como "aguardando
    //   aprovação": inativa, sem permissões e sem poder de Admin.
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin() || can('users.view'));
      allow list: if isAdmin() || can('users.view');
      allow create: if isAdmin()
                    || (!appInitialized() && request.auth != null && request.auth.uid == uid
                        && request.resource.data.role == 'admin')
                    || (appInitialized() && request.auth != null && request.auth.uid == uid
                        && request.resource.data.role == 'user'
                        && request.resource.data.active == false
                        && request.resource.data.status == 'pending'
                        && request.resource.data.perms.size() == 0);
      allow update, delete: if isAdmin();
    }

    // Usuário → login. A tela de login precisa consultar um nome por vez,
    // mas ninguém de fora consegue listar todos os usuários.
    // Quem se cadastra só pode registrar o próprio nome, junto com o próprio cadastro.
    match /logins/{username} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
                    || (request.auth != null && request.resource.data.uid == request.auth.uid
                        && (!appInitialized()
                            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username));
      allow update, delete: if isAdmin();
    }

    // Só diz se o site já tem administrador (para mostrar a tela de primeiro acesso).
    match /settings/app {
      allow read: if true;
      allow create: if !appInitialized() && request.auth != null;
      allow update, delete: if isAdmin();
    }
  }
}
